# Django
NIYAN_SECRET_KEY=change-me
NIYAN_DEBUG=false
NIYAN_ALLOWED_HOSTS=localhost,127.0.0.1
NIYAN_DATABASE_URL=postgresql://niyan:change-me@localhost:5432/niyan
NIYAN_REPOSITORIES_ROOT=/var/lib/niyan/repositories
NIYAN_ACCESS_TOKEN_MAX_DAYS=365
NIYAN_DEVICE_AUTHORIZATION_LIFETIME_SECONDS=600
NIYAN_DEVICE_AUTHORIZATION_POLL_INTERVAL_SECONDS=5
NIYAN_LFS_TRANSFER_ACTION_LIFETIME_SECONDS=900

# S3-compatible object storage
NIYAN_S3_ENDPOINT_URL=https://s3.example.com
NIYAN_S3_REGION=us-east-1
NIYAN_S3_BUCKET=niyan
NIYAN_S3_ACCESS_KEY_ID=change-me
NIYAN_S3_SECRET_ACCESS_KEY=change-me
# NIYAN_S3_SESSION_TOKEN=
NIYAN_S3_ADDRESSING_STYLE=auto
NIYAN_S3_SIGNATURE_VERSION=s3v4
NIYAN_S3_KEY_PREFIX=niyan
NIYAN_S3_VERIFY_TLS=true
NIYAN_S3_CONNECT_TIMEOUT_SECONDS=5
NIYAN_S3_READ_TIMEOUT_SECONDS=30
NIYAN_S3_MAX_ATTEMPTS=3
