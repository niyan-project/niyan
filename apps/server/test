#!/bin/sh

set -eu

server_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$server_root/../.." && pwd)
compose_file="$repository_root/deploy/compose.test.yml"
compose_project=${NIYAN_TEST_COMPOSE_PROJECT:-niyan-tests}
postgres_port=${NIYAN_TEST_POSTGRES_PORT:-55432}
git_root=$(mktemp -d "${TMPDIR:-/tmp}/niyan-test-repositories.XXXXXX")

cleanup() {
    docker compose --project-name "$compose_project" --file "$compose_file" down --volumes --remove-orphans >/dev/null 2>&1 || true
    rm -rf -- "$git_root"
}
trap cleanup EXIT HUP INT TERM

docker compose --project-name "$compose_project" --file "$compose_file" up --detach --wait database

export AWS_EC2_METADATA_DISABLED=true
export NIYAN_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
export NIYAN_DATABASE_URL="postgresql://niyan:niyan@127.0.0.1:$postgres_port/niyan"
export NIYAN_DEBUG=true
export NIYAN_GIT_ROOT="$git_root"
export NIYAN_S3_BUCKET=tests
export NIYAN_SECRET_KEY=test-only-secret-key

cd "$server_root"
uv run python manage.py makemigrations --check --dry-run
uv run coverage erase
uv run coverage run manage.py test "$@"
uv run coverage report --fail-under=85
uv run coverage xml
uv run coverage html
