# Copy to deploy/.env. Use URL-safe random hexadecimal secrets so values can
# safely appear in Docker Compose interpolation and the PostgreSQL URL.
NIYAN_IMAGE=ghcr.io/niyan-project/niyan:0.4.0

NIYAN_PUBLIC_HOST=niyan.example.org
NIYAN_OBJECT_HOST=objects.niyan.example.org
NIYAN_ACME_EMAIL=operator@example.org
NIYAN_HTTP_PORT=80
NIYAN_HTTPS_PORT=443

NIYAN_SECRET_KEY=replace-with-openssl-rand-hex-64
NIYAN_POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
NIYAN_GIT_HTTP_MAX_REQUEST_BYTES=4294967296

NIYAN_S3_REGION=us-east-1
NIYAN_S3_BUCKET=niyan
NIYAN_S3_ACCESS_KEY_ID=replace-with-openssl-rand-hex-16
NIYAN_S3_SECRET_ACCESS_KEY=replace-with-openssl-rand-hex-32
NIYAN_S3_KEY_PREFIX=niyan

# Only opt into HSTS subdomains or preload after confirming that the entire
# domain is HTTPS-only. The primary application origin receives HSTS by default.
NIYAN_SECURE_HSTS_SECONDS=31536000
NIYAN_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
NIYAN_SECURE_HSTS_PRELOAD=false
NIYAN_LOG_LEVEL=INFO
