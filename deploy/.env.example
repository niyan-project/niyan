# Copy to deploy/.env. Docker Compose reads this file for interpolation.
NIYAN_IMAGE=niyan:local
NIYAN_BIND_ADDRESS=127.0.0.1
NIYAN_PORT=8000

NIYAN_SECRET_KEY=replace-with-a-long-random-value
NIYAN_ALLOWED_HOSTS=niyan.example.org
NIYAN_CSRF_TRUSTED_ORIGINS=https://niyan.example.org
NIYAN_DATABASE_URL=postgresql://niyan:replace-me@database.example.org:5432/niyan

NIYAN_S3_ENDPOINT_URL=https://s3.example.org
NIYAN_S3_REGION=us-east-1
NIYAN_S3_BUCKET=niyan
NIYAN_S3_ACCESS_KEY_ID=replace-me
NIYAN_S3_SECRET_ACCESS_KEY=replace-me
NIYAN_S3_ADDRESSING_STYLE=auto
NIYAN_S3_SIGNATURE_VERSION=s3v4
NIYAN_S3_KEY_PREFIX=niyan
NIYAN_S3_SHA256_CHECKSUMS=false
NIYAN_S3_VERIFY_TLS=true

# Keep these defaults behind an HTTPS reverse proxy. Only opt into HSTS
# subdomains or preload after confirming the entire domain is HTTPS-only.
NIYAN_BEHIND_HTTPS_PROXY=true
NIYAN_SECURE_SSL_REDIRECT=true
NIYAN_SESSION_COOKIE_SECURE=true
NIYAN_CSRF_COOKIE_SECURE=true
NIYAN_SECURE_HSTS_SECONDS=31536000
NIYAN_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
NIYAN_SECURE_HSTS_PRELOAD=false
NIYAN_LOG_LEVEL=INFO
